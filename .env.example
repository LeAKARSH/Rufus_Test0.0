# Rufus configuration
# Copy this file to `.env` and fill in your values. Every variable here is
# optional with a sensible default; unset values use the defaults in code.

# --- Ollama: Decision Engine -----------------------------------
OLLAMA_HOST=
OLLAMA_PORT=11434
OLLAMA_MODEL=gpt-oss:20b

# --- Ollama: Sentiment scoring ---------------------------------
# Falls back to the Decision Engine host/port when left unset.
SENTIMENT_OLLAMA_HOST=
SENTIMENT_OLLAMA_PORT=11434
SENTIMENT_OLLAMA_MODEL=llama3.1:8b 

# --- Ollama: calls ------------------------------------------------
OLLAMA_TIMEOUT_SECONDS=90
# Attempts per Ollama call (transport errors + 5xx are retried with backoff).
OLLAMA_RETRY_ATTEMPTS=2

# --- Data sources ----------------------------------------------
CURRENTSAPI_KEY=

# --- Watchlist -------------------------------------------------
# Comma-separated tickers (use .NS for NSE-listed Indian stocks). On daemon
# start, any ticker missing from the DB is inserted (active). Live edits use:
#   python -m rufus ticker add|remove|active|list
# NOTE: `ticker remove` hard-deletes; if the ticker stays in WATCHLIST it is
# re-added on the next daemon start. To pause a ticker without resurrecting
# it, use:  python -m rufus ticker active TICKER false
WATCHLIST=RELIANCE.NS,TCS.NS

# --- Scheduling cadences ---------------------------------------
# Intraday price-poll interval (minutes), market hours only.
INTRADAY_POLL_MINUTES=30
# News/sentiment rotation interval (hours).
NEWS_POLL_HOURS=24
# Daily LLM decision cycle time (HH:MM, market timezone).
DECISION_CYCLE_TIME=16:00

# --- Market calendar -------------------------------------------
# Indian markets default (NSE, IST). Exchange codes: XNSE=NSE, XSES=BSE.
MARKET_EXCHANGE=XNSE
MARKET_TIMEZONE=Asia/Kolkata

# --- Rate-limit caps (adjust only if a free tier changes) ------
YAHOO_MAX_REQ_PER_HOUR=1000
CURRENTS_MAX_REQ_PER_DAY=100

# --- Retries (Phase 6) -------------------------------------------
# Transient transport failures / HTTP 5xx are retried with exponential
# backoff + jitter. Budgets are charged once per logical request, never per
# retry. CurrentsAPI (429) and Ollama 4xx are never retried.
YAHOO_RETRY_ATTEMPTS=2
CURRENTS_RETRY_ATTEMPTS=1
# Base/backoff and jitter (seconds). Applies across all providers.
RETRY_BASE_DELAY_S=1.0
RETRY_JITTER_S=0.25

# --- News rotation / prioritization ------------------------------
# Tier A search radius around an earnings date (days).
NEWS_ROTATION_EARNINGS_WINDOW_DAYS=14
# A ticker whose last news pull is this many days old becomes Tier A.
NEWS_ROTATION_OVERDUE_DAYS=7
# 90-day volatility jump (percent vs prior snapshot) that flags Tier A.
NEWS_ROTATION_VOLATILITY_SPIKE_PCT=50
# Max articles per ticker sent to the sentiment model for scoring.
NEWS_SENTIMENT_MAX_ARTICLES=15

# --- Simulation / paper trading --------------------------------
# Virtual portfolio seeded with this much paper cash (INR units).
STARTING_CASH=10000
# equal_weight | fixed_amount | confidence_weighted (swappable via code).
POSITION_SIZING_STRATEGY=equal_weight
# Buy-and-hold benchmark tracked against the portfolio (NIFTY 50 default).
BENCHMARK_TICKER=^NSEI
PORTFOLIO_NAME=default
# Max share of portfolio value any single simulated position may reach (%). 0/100 = off/cap.
MAX_ALLOCATION_PCT=100

# --- Logging ---------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Reporting (Phase 5) ----------------------------------------
# Where generated reports are written (html/md). Relative paths resolve
# against the project root.
REPORT_DIR=logs/reports

# --- Persistence ------------------------------------------------
# Relative paths resolve against the project root.
DB_PATH=data/rufus.db